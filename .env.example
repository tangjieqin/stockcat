# 复制为 .env 后按需修改（docker compose 会自动读取）
STOCKCAT_DB_NAME=stockcat
STOCKCAT_DB_USER=stockcat
STOCKCAT_DB_PASSWORD=stockcat
STOCKCAT_DB_PORT=5432

# ---- AI 助手（backend-python 读取，全部可选）----
# 三个都填才启用模型分析；不填也能用，页面会标注「规则汇总模式」
# 兼容 DeepSeek / 通义 / Kimi / OpenAI / 本地 Ollama，只改这三个值
# STOCKCAT_LLM_BASE_URL=https://api.deepseek.com/v1
# STOCKCAT_LLM_MODEL=deepseek-chat
# STOCKCAT_LLM_API_KEY=sk-xxxx
# Agent 取数指向的 Java 服务（默认 8081）
# STOCKCAT_JAVA_BASE_URL=http://127.0.0.1:8081

